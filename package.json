{
  "name": "bootcamp-app",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "install:all": "npm install --include=dev && npm install --prefix client --include=dev",
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "npm run dev --prefix client",
    "build": "npm install --prefix client --include=dev && npm run build --prefix client",
    "start": "node server/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
