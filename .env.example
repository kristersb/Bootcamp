# Copy this file to .env for local development: cp .env.example .env
# Every variable here is optional - the app runs with sensible defaults if none are set.
# See README.md's "Deploy" section for what to set on Render in production.

# Port the Express server listens on locally. Most hosts (including Render) inject PORT automatically,
# which always takes priority over this - only needed for local dev if you don't want the default 3001.
SERVER_PORT=3001

# Where the SQLite database file lives. Defaults to server/data.sqlite. Only set this if you've attached
# a persistent disk on your host and want the database to live there instead (see README).
# DATABASE_PATH=/var/data/data.sqlite

# A Discord incoming webhook URL. If set, a test case marked "failed" during a run posts an alert there.
# Leave unset to disable Discord alerts entirely - the app works fine without it.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# The public URL this app is deployed at, used to build the run link inside Discord alerts.
# Defaults to http://localhost:5173, which is correct for local dev. Set this to your real deployed
# URL in production, e.g. https://strata-qa.onrender.com
# APP_BASE_URL=http://localhost:5173
